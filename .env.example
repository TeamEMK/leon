DB_KIND=postgres
DATABASE_URL=
# Railway ke andar wale (private network) Postgres par TLS nahi hota — tab
# PGSSL_DISABLE=true. Public proxy host (…proxy.rlwy.net) par isse khaali chhodo.
PGSSL_DISABLE=
NODE_ENV=
PORT=
# Container UTC me chalta hai. Email reminder scheduler server ke local ghante
# dekhta hai, isliye TZ set na ho to 12 PM ka mail 5:30 PM IST ko jaata hai.
TZ=Asia/Kolkata
SESSION_SECRET=
APP_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CRON_SECRET=
GOOGLE_CREDENTIALS_B64=
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SECRET=
GDRIVE_VIDEO_FOLDER_ID=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
WAUMFY_API_KEY=
WAUMFY_TRIGGER_URL=
WAUMFY_DOC_TRIGGER_URL=
WAUMFY_IMAGE_TRIGGER_URL=
WA_SCHEDULER_ENABLED=
