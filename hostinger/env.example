# ─────────────────────────────────────────────────────────────
# Leon on Hostinger — Environment Variables
# Hostinger hPanel -> your Node.js app -> "Environment variables" me ye add karo
# (ya is file ko .env naam se app folder me rakh do).
# ─────────────────────────────────────────────────────────────

# ── Database (hPanel -> Databases -> MySQL Databases me banao) ──
DB_KIND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_leon
DB_USER=u123456789_leon
DB_PASSWORD=

# ── App ──
NODE_ENV=production
TZ=Asia/Kolkata
# Naya domain, jaise https://tasks.yourcompany.com
APP_URL=
# IMPORTANT: Railway wali SAME value rakho — tab sab log logged-in rahenge.
SESSION_SECRET=
# Random lamba secret (cron URLs ke liye). Khaali chhodoge to /api/cron/* band rahenge.
CRON_SECRET=

# ── Railway ke baaki variables jyon ke tyon copy karo (jo use hote the) ──
GOOGLE_CREDENTIALS_B64=
GDRIVE_FMS_FOLDER_ID=
GDRIVE_VIDEO_FOLDER_ID=
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SECRET=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
WAUMFY_API_KEY=
WAUMFY_TRIGGER_URL=
WAUMFY_DOC_TRIGGER_URL=
WAUMFY_IMAGE_TRIGGER_URL=
WA_SCHEDULER_ENABLED=
